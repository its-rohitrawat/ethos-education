# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets live only in .env.local / the host's environment settings
.env*
!.env.example
!.env.development

# leads captured locally by the development fallback (contains personal data — never commit)
/.leads/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# licensed fonts (Hanken Basic License: no redistribution / web use) — kept locally, never committed
/src/app/fonts/HKGroteskWide-*
