# Copy to .env.local for development, or set these in your hosting provider's environment settings.
# Never commit real values. Variables prefixed NEXT_PUBLIC_ are visible in the browser — only
# publishable values belong there.

# --- Site -------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.ethoseducation.world
# Show unverified claims (stats, testimonials, addresses) with "Pending verification" badges.
# true in development/preview only. Leave unset in production.
# Show orange "Pending verification" badges on unverified content (content review only).
NEXT_PUBLIC_VERIFY_BADGES=
NEXT_PUBLIC_SHOW_UNVERIFIED=
# Set to true on staging/preview deployments to block search-engine indexing.
NEXT_PUBLIC_NOINDEX=
# Extra origins allowed to POST the consultation form (comma-separated), e.g. a preview domain.
ALLOWED_ORIGINS=

# --- Webflow CMS (server-only) -------------------------------------------------------------
WEBFLOW_API_TOKEN=
WEBFLOW_WEBHOOK_SECRET=
WEBFLOW_COLLECTION_ARTICLES=
WEBFLOW_COLLECTION_FAQS=
WEBFLOW_COLLECTION_VIDEO_STORIES=
WEBFLOW_COLLECTION_OUTCOMES=
WEBFLOW_COLLECTION_STATS=
WEBFLOW_COLLECTION_OFFICES=
WEBFLOW_COLLECTION_PROGRAMMES=
WEBFLOW_COLLECTION_EXAMS=
WEBFLOW_COLLECTION_DESTINATIONS=

# --- Lead delivery (server-only) -------------------------------------------------------------
# One of: hubspot | zoho | webhook   (leave empty to use email notification only)
CRM_PROVIDER=
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=
HUBSPOT_PRIVATE_APP_TOKEN=
ZOHO_DC=in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=

# Email notification of each lead via Resend
RESEND_API_KEY=
LEADS_EMAIL_FROM=
LEADS_EMAIL_TO=

# --- Spam protection (optional) ---------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics (optional, loaded only after consent) -----------------------------------------------
NEXT_PUBLIC_GA4_ID=
